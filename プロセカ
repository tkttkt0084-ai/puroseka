<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>Mini Rhythm Game</title>
<style>
body{
    background:#111;
    margin:0;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    color:white;
    font-family:sans-serif;
}

#game{
    position:relative;
    width:400px;
    height:700px;
    background:#222;
    overflow:hidden;
    border:3px solid #fff;
}

.lane{
    position:absolute;
    top:0;
    width:25%;
    height:100%;
    border-left:1px solid #555;
    border-right:1px solid #555;
}

.lane:nth-child(1){left:0;}
.lane:nth-child(2){left:25%;}
.lane:nth-child(3){left:50%;}
.lane:nth-child(4){left:75%;}

.note{
    position:absolute;
    width:90%;
    height:20px;
    left:5%;
    border-radius:10px;
    background:#4fc3f7;
}

#judgeLine{
    position:absolute;
    bottom:100px;
    width:100%;
    height:5px;
    background:#ff4081;
}

#score{
    position:absolute;
    top:10px;
    left:10px;
    font-size:24px;
}
</style>
</head>
<body>

<div id="game">
    <div id="score">Score: 0</div>

    <div class="lane"></div>
    <div class="lane"></div>
    <div class="lane"></div>
    <div class="lane"></div>

    <div id="judgeLine"></div>
</div>

<script>
const game = document.getElementById("game");
const scoreText = document.getElementById("score");

let score = 0;

const keys = ["d","f","j","k"];
const notes = [];

function spawnNote(lane){
    const note = document.createElement("div");
    note.className = "note";

    const laneWidth = game.clientWidth / 4;
    note.style.left = (lane * laneWidth + laneWidth*0.05) + "px";
    note.style.top = "-20px";

    game.appendChild(note);

    notes.push({
        el:note,
        lane:lane,
        y:-20
    });
}

function gameLoop(){
    for(let i=notes.length-1;i>=0;i--){
        const note=notes[i];

        note.y += 4;
        note.el.style.top = note.y + "px";

        if(note.y > 700){
            note.el.remove();
            notes.splice(i,1);
        }
    }

    requestAnimationFrame(gameLoop);
}

document.addEventListener("keydown",(e)=>{
    const lane = keys.indexOf(e.key.toLowerCase());

    if(lane === -1) return;

    const judgeY = 580;

    for(let i=0;i<notes.length;i++){
        const note = notes[i];

        if(note.lane !== lane) continue;

        const diff = Math.abs(note.y - judgeY);

        if(diff < 40){
            score += 100;
            scoreText.textContent = "Score: " + score;

            note.el.remove();
            notes.splice(i,1);
            return;
        }
    }
});

setInterval(()=>{
    const lane = Math.floor(Math.random()*4);
    spawnNote(lane);
},800);

gameLoop();
</script>

</body>
</html>
const lanes = document.querySelectorAll(".lane");

lanes.forEach((laneEl, laneIndex) => {
    laneEl.addEventListener("touchstart", () => {
        judge(laneIndex);
    });

    laneEl.addEventListener("click", () => {
        judge(laneIndex);
    });
});

function judge(lane){
    const judgeY = 580;

    for(let i=0;i<notes.length;i++){
        const note = notes[i];

        if(note.lane !== lane) continue;

        const diff = Math.abs(note.y - judgeY);

        if(diff < 40){
            score += 100;
            scoreText.textContent = "Score: " + score;

            note.el.remove();
            notes.splice(i,1);
            return;
        }
    }
}
